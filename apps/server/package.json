  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^8.0.11",
    "@types/ws": "^8.18.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.16.0"
