    "@yesimbot/foundation": "workspace:^",
    "@yesimbot/onebot": "workspace:^",
    "koa": "^2.16.4",
    "koa-body": "^6.0.1",
    "koishi-plugin-adapter-wechat-bridge": "workspace:^",
    "koishi-plugin-yesimbot": "workspace:^",
    "koishi-plugin-yesimbot-console": "workspace:^",
    "koishi-plugin-yesimbot-device-connection": "workspace:^",
    "koishi-plugin-yesimbot-google": "workspace:^",
    "koishi-plugin-yesimbot-image-tools": "workspace:^",
    "koishi-plugin-yesimbot-mcp-client": "workspace:^",
    "koishi-plugin-yesimbot-memorizer": "workspace:^",
    "koishi-plugin-yesimbot-message-debounce": "workspace:^",
    "koishi-plugin-yesimbot-model-provider": "workspace:^",
    "koishi-plugin-yesimbot-onebot-utils": "workspace:^",
