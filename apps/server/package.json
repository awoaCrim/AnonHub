      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pkgroll --sourcemap=inline",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
