<?xml version="1.0" encoding="utf-8"?>
<!-- The app's whole data directory, which holds the WebView's signed-in session, stays on this phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
