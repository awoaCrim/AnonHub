{
  "name": "@yesimbot/character-cards",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pkgroll --sourcemap=inline && node -e \"require('node:fs').cpSync('src/presets', 'dist/presets', { recursive: true })\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@yesimbot/contracts": "workspace:^",
    "@yesimbot/foundation": "workspace:^"
  },
  "devDependencies": {
    "vitest": "^4.0.18"
  }
}
