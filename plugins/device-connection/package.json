{
  "name": "koishi-plugin-yesimbot-device-connection",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "require": "./dist/extension.cjs",
      "default": "./dist/extension.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pkgroll",
    "check-types": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yesimbot/device-client": "workspace:^",
    "@yesimbot/device-gateway": "workspace:^",
    "@yesimbot/foundation": "workspace:^",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "koishi-plugin-yesimbot": "workspace:^",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "koishi-plugin-yesimbot": "workspace:^"
  }
}
