{
  "name": "koishi-plugin-yesimbot-console",
  "version": "0.0.1",
  "description": "YesImBot console",
  "files": [
    "lib",
    "dist"
  ],
  "main": "./lib/server.js",
  "types": "./lib/server.d.ts",
  "exports": {
    ".": {
      "types": "./lib/server.d.ts",
      "require": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./server": {
      "types": "./lib/server.d.ts",
      "require": "./lib/server.js",
      "default": "./lib/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npx tsc -p tsconfig.json && node build.mjs",
    "check-types": "tsc --noEmit",
    "clean": "rimraf lib && rimraf dist && rimraf tsconfig.tsbuildinfo",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "pub": "yarn npm publish --access public"
  },
  "dependencies": {
    "@yesimbot/agent-runtime": "workspace:^",
    "@yesimbot/character-cards": "workspace:^",
    "@yesimbot/contracts": "workspace:^",
    "@yesimbot/foundation": "workspace:^",
    "@yesimbot/onebot": "workspace:^",
    "@yesimbot/wechat-transport": "workspace:^",
    "qrcode": "1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@novnc/novnc": "1.7.0",
    "@tailwindcss/vite": "^4",
    "@types/markdown-it": "^14.2.0",
    "@types/novnc__novnc": "^1",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vueuse/core": "^15.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "koishi-plugin-yesimbot": "workspace:^",
    "markdown-it": "^15.0.3",
    "papaparse": "^5.7.1",
    "reicon-vue": "^1.1.104",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.4.10",
    "vue": "^3.5.46",
    "vue-router": "^4.4.5"
  }
}
